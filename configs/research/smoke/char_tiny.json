{
  "model": {
    "context_length": 32,
    "embed_dim": 32,
    "num_layers": 2,
    "num_heads": 4,
    "dropout": 0.0,
    "attention_backend": "sdpa",
    "positional_encoding": "learned"
  },
  "training_seeds": [42],
  "conditioning_themes": ["春日相思", "秋夜思乡", "山水隐逸", "边塞报国", "怀古伤今", "人生感悟"],
  "pretrain_tokens": 128,
  "finetune_tokens": 128,
  "batch_size": 2,
  "learning_rate": 0.0003,
  "finetune_learning_rate": 0.0001,
  "warmup_steps": 1,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "eval_every": 1,
  "save_every": 1,
  "dataset_dir": "data/research/processed",
  "output_dir": "artifacts/research/smoke/char"
}
