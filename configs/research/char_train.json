{
  "model": {
    "context_length": 256,
    "embed_dim": 256,
    "num_layers": 6,
    "num_heads": 8,
    "dropout": 0.1,
    "attention_backend": "sdpa",
    "positional_encoding": "learned"
  },
  "training_seeds": [42, 1729, 2026],
  "conditioning_themes": ["春日相思", "秋夜思乡", "山水隐逸", "边塞报国", "怀古伤今", "人生感悟"],
  "pretrain_tokens": 100000000,
  "finetune_tokens": 10000000,
  "batch_size": 32,
  "learning_rate": 0.0003,
  "finetune_learning_rate": 0.0001,
  "warmup_steps": 1000,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "eval_every": 200,
  "save_every": 1000,
  "dataset_dir": "data/research/processed",
  "output_dir": "artifacts/research/char"
}
